{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "مساعد بصيرة",
  "language": "ar",
  "colors": {
    "primary": "#4B5349",
    "light": "#394034",
    "dark": "#394034"
  },
  "favicon": {
    "light": "/images/Screenshot2026-08-21at22.26.30.png",
    "dark": "/images/Screenshot2026-08-21at22.26.30.png"
  },
  "navigation": {
    "pages": [
      {
        "group": "هنا البداية",
        "pages": [
          "index",
          "quickstart"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "الوثائق",
          "href": "https://mintlify.com/docs",
          "icon": "book-open-cover"
        },
        {
          "anchor": "المقالات",
          "href": "https://mintlify.com/blog",
          "icon": "newspaper"
        }
      ]
    }
  },
  "logo": {
    "light": "/images/baseera-logo-horizontal.png",
    "dark": "/images/baseera-logo-horizontal.png",
    "href": "https://www.baseera.cz"
  },
  "navbar": {
    "links": [
      {
        "href": "mailto:support@baseera.cz",
        "label": "راسلنا"
      },
      {
        "href": "https://baseera.cz/",
        "label": "الموقع"
      }
    ],
    "primary": {
      "type": "button",
      "label": "تسجيل الدخول",
      "href": "https://baseera.cz/portal?lang=ar"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "linkedin": "https://linkedin.com/company/baseera-cz",
      "instagram": "https://instagram.com/baseera.cz",
      "website": "https://www.baseera.cz"
    }
  },
  "icons": {
    "library": "fontawesome"
  },
  "appearance": {
    "default": "light",
    "strict": true
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "metadata": {
    "timestamp": true
  },
  "background": {
    "color": {
      "light": "#F6F4F1",
      "dark": "#F6F4F1"
    }
  }
}
